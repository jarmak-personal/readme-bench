# Stripped repository snapshots (regenerate with scripts/prepare-target.sh; lock files are kept)
/targets/*/

# Working copies live in /private/var/tmp/ws/<random>/, outside $HOME, and are deleted after each run

# Copilot CLI runtime state inside the bench COPILOT_HOME (keep settings.json only)
/harness/copilot/*
!/harness/copilot/settings.template.json

# Bulky per-run logs
/results/**/logs/

.DS_Store

# Generated by scripts/build-site.py (the Pages workflow rebuilds it)
/site/data/

# Keep the harness process logs for the GPT-5.6 Sol @ none run that ended with "I'm powered by GPT-5.3-Codex."
!/results/hvir/2026-09-17_r3_copilot-cli-1.0.86_effort-min/gpt-5.6-sol__copilot-cli__20260918T024841Z/logs/

# Private sanitizer config (scripts/sanitize-results.py): literal strings to scrub
/.sanitize.json
